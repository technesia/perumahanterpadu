# Koneksi PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tprm?schema=public"
# Database terpisah khusus automated test (akan di-reset oleh test)
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tprm_test?schema=public"

# Organization context — ditentukan server, tidak bisa diubah lewat request
ORGANIZATION_SLUG="taman-pesona-rajeg-mulya"

# Rahasia acak minimal 32 karakter (openssl rand -hex 32)
SESSION_SECRET=""
SESSION_TTL_HOURS="12"
# Set "true" HANYA bila aplikasi berada di belakang reverse proxy tepercaya (nginx/Caddy)
# yang menimpa header X-Real-IP / X-Forwarded-For. Dipakai untuk rate limiting per IP.
TRUST_PROXY="false"
# HANYA untuk uji lokal lewat http://localhost (Docker). Jangan diset di server production.
LOCAL_HTTP="false"
# Kunci enkripsi kolom sensitif (NIK). Jangan diganti setelah ada data.
DATA_ENCRYPTION_KEY=""

# Hanya Vercel/Supabase: koneksi LANGSUNG (port 5432) untuk migration & seed saat build.
# DATABASE_URL di Vercel memakai pooler mode transaksi (port 6543, ?pgbouncer=true&connection_limit=5).
DIRECT_URL=""

# Penyimpanan berkas privat (bukti transfer, dokumen warga)
#   disk     = folder STORAGE_DIR di server (VPS/Docker/lokal)
#   supabase = bucket PRIVAT Supabase Storage (wajib di Vercel)
STORAGE_DRIVER="disk"
STORAGE_DIR="./storage"
SUPABASE_URL=""
# Service role key: RAHASIA, hanya di server. Jangan pernah dipakai di kode browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="berkas-privat"
# Maksimal 4 (batas body request Vercel 4,5 MB)
MAX_UPLOAD_MB="4"

# Kontak darurat. Nomor nasional di bawah WAJIB diverifikasi sebelum production,
# lalu set EMERGENCY_VERIFIED="true".
EMERGENCY_AMBULANCE="119"
EMERGENCY_POLICE="110"
EMERGENCY_PLN="123"
EMERGENCY_VERIFIED="false"

# Integrasi QRIS (belum aktif). Kosongkan bila provider belum tersedia.
QRIS_PROVIDER=""
QRIS_SERVER_KEY=""
QRIS_WEBHOOK_SECRET=""
